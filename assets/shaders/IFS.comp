#version 430 core

// Keep local_size_x synchronized with POINT_COMPUTE_LOCAL_SIZE in render_interface.h.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer PointBuffer
{
        vec4 points[];
};

uniform int pointCount;
uniform float timeSeconds;
uniform mat4 IFSmat;

void main()
{
        uint pID = gl_GlobalInvocationID.x;
        if(pID >= uint(pointCount)) return;

        points[pID] = vec4(points[pID] * IFSmat);
}