#version 430 core

// Keep local_size_x synchronized with POINT_COMPUTE_LOCAL_SIZE in render_interface.h.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer PointBuffer
{
        vec4 points[];
};

layout(std430, binding = 1) readonly buffer MatrixBuffer
{
        mat4 IFSMatrices[];
};

uniform int pointCount;
uniform float TIME;
uniform int matrixCount;

uint hash(uint value)
{
        value ^= value >> 16;
        value *= 0x7feb352du;
        value ^= value >> 15;
        value *= 0x846ca68bu;
        value ^= value >> 16;
        return value;
}

void main()
{
        uint pID = gl_GlobalInvocationID.x;
        if(pID >= uint(pointCount) || matrixCount <= 0) return;

        uint seed = pID ^ uint(TIME * 60.0);
        uint matrixIndex = hash(seed) % uint(matrixCount);
        points[pID] = IFSMatrices[matrixIndex] * points[pID];
}