#version 430 core

#define hash(x) lowbias32(x)

// Keep local_size_x synchronized with POINT_COMPUTE_LOCAL_SIZE in render_interface.h.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer PointsBuffer
{
        vec4 points[];
};

layout(std430, binding = 1) readonly buffer TransformBuffer
{
        mat4 transforms[];
};

layout(std430, binding = 2) buffer SpatialGridBuffer
{
        uint spatialGrid[];
};

layout(std430, binding = 3) readonly buffer BoundsBuffer
{
        vec4 boundsMin;
        vec4 boundsMax;
        uint boundsValid;
};



uniform float TIME;

uniform int pointCount;
uniform int matrixCount;
uniform int AOgridSize;


// Debug bounding-box corners and their wireframe edges.
vec3 vertices[] =
{
        vec3(0, 0, 0),
        vec3(1, 0, 0),
        vec3(1, 1, 0),
        vec3(0, 1, 0),
        vec3(0, 0, 1),
        vec3(1, 0, 1),
        vec3(1, 1, 1),
        vec3(0, 1, 1)
};
const int edgeCount = 24;
const int indices[edgeCount] =
{
    0, 1,
    1, 2,
    2, 3,
    3, 0,

    4, 5,
    5, 6,
    6, 7,
    7, 4,

    0, 4,
    1, 5,
    2, 6,
    3, 7
};

uint lowbias32(uint x)
{
        x ^= x >> 16;
        x *= 0x7feb352dU;
        x ^= x >> 15;
        x *= 0x846ca68bU;
        x ^= x >> 16;
        return x;
}

void main()
{
        uint pID = gl_GlobalInvocationID.x;
        if(pID >= uint(pointCount)) return;
        if(matrixCount <= 0 || boundsValid == 0u) return;

        uint frame = uint(TIME * 600.0);
        vec4 point = points[pID];

        // Get random matrix index
        uint seed = pID ^ (frame * 0x9e3779b9u) ^ (0x85ebca6bu);
        uint matrixIndex = lowbias32(seed) % uint(matrixCount);

        // Map the attractor box into the grid's [-0.5, 0.5] coordinate range.
        vec3 center = (boundsMin.xyz + boundsMax.xyz) * 0.5;
        vec3 boundsExtent = boundsMax.xyz - boundsMin.xyz;
        float extent = max(max(boundsExtent.x, boundsExtent.y), boundsExtent.z);
        if(extent <= 1e-6) return;
        float scale = 0.9 / extent;

        // Apply each IFS map in the centered/scaled coordinate space:
        // C * T * inverse(C), where C maps original coordinates to grid space.
        vec3 originalPoint = point.xyz / scale + center;
        vec3 transformedPoint = (transforms[matrixIndex] * vec4(originalPoint, 1.0)).xyz;
        point = vec4((transformedPoint - center) * scale, 1.0);

        points[pID] = point;
        
        // Bounding box debug visualization
        //if (pID == 0)
        // {
        //         for (int i = 0; i < edgeCount; i += 2)
        //         {
        //                 if (boundsValid != 0u)
        //                 {
        //                         vec3 start = mix(boundsMin.xyz, boundsMax.xyz, vertices[indices[i]]);
        //                         vec3 end = mix(boundsMin.xyz, boundsMax.xyz, vertices[indices[i + 1]]);
        //                         points[pointCount + i] = vec4(start, 1.0);
        //                         points[pointCount + i + 1] = vec4(end, 1.0);
        //                 }
        //                 else
        //                 {
        //                         points[pointCount + i] = vec4(0.0);
        //                         points[pointCount + i + 1] = vec4(0.0);
        //                 }
        //         }
        // }


        //points[pID].x += float(pID) * 0.00001;
        //points[pID].x += 0.001;
        // Map normalized coordinates into the same clamped grid used by rendering.
        ivec3 gridCell = ivec3(floor((point.xyz + vec3(0.5)) * float(AOgridSize)));
        if(all(greaterThanEqual(gridCell, ivec3(0))) &&
           all(lessThan(gridCell, ivec3(AOgridSize))))
        {
                uint cellIndex = uint(gridCell.x +
                        AOgridSize * (gridCell.y + AOgridSize * gridCell.z));
                atomicOr(spatialGrid[cellIndex], 1u);
        }
}