#version 430 core

layout(local_size_x = 256) in;

layout(std430, binding = 1) readonly buffer TransformBuffer
{
        mat4 transforms[];
};

layout(std430, binding = 3) writeonly buffer BoundsBuffer
{
        vec4 boundsMin;
        vec4 boundsMax;
        uint boundsValid;
};

uniform int matrixCount;

const uint warmupIterations = 64;
const uint sampleIterations = 512;
const uint workgroupSize = 256;
const float safetyMargin = 0.02;

shared vec3 threadMins[workgroupSize];
shared vec3 threadMaxs[workgroupSize];

uint lowbias32(uint x)
{
        x ^= x >> 16;
        x *= 0x7feb352dU;
        x ^= x >> 15;
        x *= 0x846ca68bU;
        x ^= x >> 16;
        return x;
}

void main()
{
        uint localID = gl_LocalInvocationID.x;

        if (matrixCount <= 0)
        {
                if (localID == 0)
                {
                        boundsMin = vec4(0.0);
                        boundsMax = vec4(0.0);
                        boundsValid = 0u;
                }
                return;
        }

        vec4 point = vec4(0.0, 0.0, 0.0, 1.0);
        vec3 sampleMin = vec3(1e30);
        vec3 sampleMax = vec3(-1e30);
        uint seed = lowbias32(localID + 0x9e3779b9u);

        for (uint iteration = 0; iteration < warmupIterations + sampleIterations; ++iteration)
        {
                seed = lowbias32(seed + iteration + 0x85ebca6bu);
                uint matrixIndex = seed % uint(matrixCount);
                point = transforms[matrixIndex] * point;

                if (iteration >= warmupIterations)
                {
                        sampleMin = min(sampleMin, point.xyz);
                        sampleMax = max(sampleMax, point.xyz);
                }
        }

        threadMins[localID] = sampleMin;
        threadMaxs[localID] = sampleMax;
        barrier();

        for (uint stride = workgroupSize / 2; stride > 0; stride >>= 1)
        {
                if (localID < stride)
                {
                        threadMins[localID] = min(threadMins[localID], threadMins[localID + stride]);
                        threadMaxs[localID] = max(threadMaxs[localID], threadMaxs[localID + stride]);
                }
                barrier();
        }

        if (localID == 0)
        {
                vec3 extent = threadMaxs[0] - threadMins[0];
                vec3 padding = max(extent * safetyMargin, vec3(0.01));
                boundsMin = vec4(threadMins[0] - padding, 0.0);
                boundsMax = vec4(threadMaxs[0] + padding, 0.0);
                boundsValid = 1u;
        }
}
